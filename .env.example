# ============================================================================
# DATA LAYER SERVICE - Configuration Template
# Multi-Source Trend Intelligence Platform
# ============================================================================
# Copy this file to .env and update with your values if needed
# (Most settings work with defaults - only API keys are optional)
# ============================================================================

# Application Settings
DEBUG=False
LOG_LEVEL=INFO
VERSION=0.1.0

# Server Settings
HOST=0.0.0.0
PORT=8000

# CORS Settings
# List of allowed origins for CORS
# Use "*" to allow requests from any origin
ALLOWED_ORIGINS=["http://localhost:3000", "http://localhost:8000", "*"]

# ============================================================================
# API KEYS - OPTIONAL (NOT REQUIRED FOR CURRENT MVP)
# Currently using REAL multi-source APIs (no keys needed!)
# ============================================================================

# Reddit API (optional - for PRAW authentication)
# Get from: https://www.reddit.com/prefs/apps
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=DataLayerBot/1.0

# Groq API (optional - for future content generation)
GROQ_API_KEY=

# Cloudflare Workers AI (for image generation)
# Get values from: Workers AI -> Use REST API
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_IMAGE_MODEL=@cf/black-forest-labs/flux-2-klein-4b

# ============================================================================
# ACTIVE DATA SOURCES (4 WORKING - No API keys required!)
# ============================================================================
#
# ✅ CURRENTLY WORKING:
#    • HackerNews   → Firebase API (100% free, public)
#    • Reddit       → JSON API trick (no authentication)
#    • Dev.to       → Public API (unlimited free)
#    • Hashnode     → GraphQL API (no auth required)
#
# ⚠️  FALLBACK (Google blocks bots):
#    • Google Trends→ pytrends library (returns 0 topics)
#
# Response time: ~3-5 seconds (all sources fetched in parallel)
# Error tolerance: System continues if any source fails
# Deduplication: Automatic across all sources
# Score normalization: 0-100 scale across all sources
#
# ============================================================================

